{
  "name": "proxylink-pc",
  "version": "2.2.1",
  "description": "proxylink pc app",
  "author": "proxylink",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "npm run build && electron .",
    "selftest": "npm run build && node test/selftest.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.12",
    "clipboardy": "^2.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/qrcode": "^1.5.5"
  },
  "build": {
    "appId": "dev.proxylink.pc",
    "productName": "proxylink",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true
    }
  }
}